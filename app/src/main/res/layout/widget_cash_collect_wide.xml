<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wide_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_nothing_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: App Brand & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COLLECTFLOW"
            android:textColor="#D71921"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            android:text="// LIVE TRACKER"
            android:textColor="#777777"
            android:textSize="9sp"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/widget_wide_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 DONE"
            android:textColor="#888888"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <!-- Center Section: Dual Metric Display (TO COLLECT vs COLLECTED TODAY) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <!-- Left Column: TO COLLECT / PENDING -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_wide_pending_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TO COLLECT"
                android:textColor="#D4A843"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_wide_pending_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_wide_pending_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 PENDING"
                android:textColor="#888888"
                android:textSize="9sp"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Divider Line using RemoteViews-safe FrameLayout -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="38dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#222222" />

        <!-- Right Column: COLLECTED TODAY -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COLLECTED TODAY"
                android:textColor="#888888"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:id="@+id/widget_wide_today_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_wide_commission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMM: ₹0"
                android:textColor="#4A9E5C"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: Alert Status & Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_wide_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✓ ALL REPORTED"
            android:textColor="#4A9E5C"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_wide_btn_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nothing_btn_pill_outline"
                android:paddingLeft="9dp"
                android:paddingRight="9dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginRight="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPEN"
                    android:textColor="#E8E8E8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_wide_btn_quick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nothing_btn_pill_white"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ QUICK"
                    android:textColor="#000000"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
