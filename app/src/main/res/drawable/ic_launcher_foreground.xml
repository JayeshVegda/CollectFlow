<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher foreground: the rupee mark, drawn as line work in the Nothing OS industrial monochrome
  style — white strokes on the black background, the same mark as the status-bar icon.

  The previous foreground was a solid white disc with the rupee knocked out of it, which fought the
  green background and read as a generic store icon rather than as this app.

  Geometry sits inside the adaptive-icon safe zone (66dp circle centred in the 108dp canvas, i.e.
  x/y between 21 and 87), so no launcher shape can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top bar -->
    <path
        android:pathData="M34,36 H74"
        android:strokeColor="#4A9E5C"
        android:strokeWidth="5.5"
        android:strokeLineCap="square" />

    <!-- Crossbar -->
    <path
        android:pathData="M34,52 H74"
        android:strokeColor="#4A9E5C"
        android:strokeWidth="5.5"
        android:strokeLineCap="square" />

    <!-- Bowl, bulging right of the stem -->
    <path
        android:pathData="M52,36 A8,8 0 0 1 52,52"
        android:strokeColor="#4A9E5C"
        android:strokeWidth="5.5" />

    <!-- Descending leg -->
    <path
        android:pathData="M52,52 L74,78"
        android:strokeColor="#4A9E5C"
        android:strokeWidth="5.5"
        android:strokeLineCap="square" />

    <!-- Beta indicator dot in Nothing OS style -->
    <path
        android:pathData="M78,36 A3.5,3.5 0 1 1 78,35.9 Z"
        android:fillColor="#4A9E5C" />
</vector>
